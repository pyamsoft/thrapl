_thrapl() {
  COMPREPLY=()
  local cur="${COMP_WORDS[COMP_CWORD]}"
  local prev="${COMP_WORDS[COMP_CWORD - 1]}"
  local short_actions="-V -H -S -G -d -q"
  local long_actions="--quiet --version --help --set --get --debug --pl1 --pl2 --delay"


  if [[ ${cur} = --* ]]; then
    if [[ ${prev} = "--set" ]] || [[ ${prev} = "-S" ]]; then
      mapfile -t COMPREPLY < <(compgen -W "" -- "${cur}")
    elif [[ ${prev} = "--get" ]] || [[ ${prev} = "-G" ]]; then
      mapfile -t COMPREPLY < <(compgen -W "" -- "${cur}")
    else
      mapfile -t COMPREPLY < <(compgen -W "${long_actions}" -- "${cur}")
    fi
  elif [[ ${cur} = * ]]; then
    if [[ ${prev} = "--set" ]] || [[ ${prev} = "-S" ]]; then
      mapfile -t COMPREPLY < <(compgen -W "" -- "${cur}")
    elif [[ ${prev} = "--get" ]] || [[ ${prev} = "-G" ]]; then
      mapfile -t COMPREPLY < <(compgen -W "" -- "${cur}")
    else
      mapfile -t COMPREPLY < <(compgen -W "${short_actions}" -- "${cur}")
    fi
  fi

  unset cur
  unset prev
  unset short_actions
  unset long_actions
}

complete -F _thrapl thrapl
